{
  "name": "mory-place",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate.ts",
    "check": "astro check && npm run cms:check && npm run analytics:check",
    "build": "npm run validate && astro build --force && node scripts/index-search.ts",
    "preview": "astro preview",
    "test": "node --test tests/*.test.ts && npm run test:cms && npm run analytics:test",
    "verify": "node scripts/verify-build.ts",
    "cms:build": "vite build --config cms/vite.config.ts && vite build --config cms/preview.config.ts",
    "cms:check": "tsc -p cms/tsconfig.json",
    "cms:serve": "tsx cms/server/index.ts",
    "cms:start": "sh cms/scripts/start.sh",
    "cms:backup": "tsx cms/scripts/backup.ts",
    "test:cms": "tsx --test cms/tests/*.test.ts",
    "analytics:check": "tsc -p analytics/tsconfig.json && tsc -p analytics/tsconfig.tests.json",
    "analytics:test": "tsx --test analytics/tests/*.test.ts",
    "analytics:build": "wrangler deploy --config analytics/wrangler.jsonc --dry-run --outdir ../runtime/analytics-build",
    "analytics:migrate:local": "wrangler d1 migrations apply mory-analytics --config analytics/wrangler.jsonc --local --persist-to runtime/analytics-local",
    "analytics:measure": "tsx analytics/scripts/measure.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@hono/node-server": "^2.1.3",
    "astro": "^7.3.5",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "hono": "^4.13.12",
    "katex": "^0.18.9",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "ulid": "^3.0.2",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261001.0-alpha",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "vfile": "^6.0.3",
    "vite": "^8.3.1",
    "wrangler": "^4.147.0"
  }
}
