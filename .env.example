# Default: local fixtures. Change only when the public media host is ready.
# MORY_ASSET_BASE=https://img.mory.place

# CMS server only. Never prefix credentials with VITE_.
# MORY_CMS_PORT=40009
# MORY_CMS_ORIGIN=http://127.0.0.1:40009
# For Tailnet access, use this origin instead of the local origin above:
# MORY_CMS_ORIGIN=https://mory.mau-hamal.ts.net
# MORY_RUNTIME_DIR=runtime
# Default remote comes from origin (GitHub uses SSH).
# MORY_PUBLISH_REMOTE=git@github.com:braininavat06/mory.git
# MORY_PUBLISH_BRANCH=main
# MORY_GIT_NAME=Mory CMS
# MORY_GIT_EMAIL=mory-cms@users.noreply.github.com
# Optional for private Actions reads / authenticated rate limit / deployment retry.
# MORY_GITHUB_TOKEN=

# Image upload — server only. Set values in the ignored root .env.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional positive integer limits.
MORY_IMAGE_MAX_BYTES=
MORY_IMAGE_MAX_PIXELS=
# Private CMS Analytics (independent of R2; no values committed)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_API_TOKEN=
MORY_ANALYTICS_STORAGE_THRESHOLDS=
MORY_GSC_SERVICE_ACCOUNT_FILE=
MORY_GSC_PROPERTY=
