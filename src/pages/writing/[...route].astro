---
import { getCollection, render } from 'astro:content';
import { readContent, publishedPosts } from '../../lib/content.ts';
import type { Post } from '../../lib/content.ts';
import { listPages, listUrl } from '../../lib/listing.ts';
import type { Listing } from '../../lib/listing.ts';
import ListingLayout from '../../layouts/Listing.astro';
import PostLayout from '../../layouts/Post.astro';
import Base from '../../layouts/Base.astro';
export function getStaticPaths() {
  const posts = publishedPosts(readContent());
  return [
    ...listPages(posts, '/writing/').map(listing => ({ params: { route: listUrl(listing.base, listing.sort, listing.page).slice('/writing/'.length).replace(/\/$/, '') || undefined }, props: { kind: 'listing', listing } })),
    ...posts.map(post => ({ params: { route: post.data.slug }, props: { kind: 'post', post } })),
    ...posts.flatMap(post => post.data.aliases.map(alias => ({ params: { route: alias }, props: { kind: 'alias', post } }))),
  ];
}
interface Props { kind: 'listing' | 'post' | 'alias'; listing?: Listing; post?: Post }
const { kind, listing, post } = Astro.props;
const entry = kind === 'post' ? (await getCollection('posts')).find(entry => entry.data.id === post!.data.id) : undefined;
if (kind === 'post' && !entry) throw new Error(`${post!.file}: Astro collection entry를 찾지 못했습니다.`);
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const destination = post ? `/writing/${post.data.slug}/` : '';
---
{kind === 'listing' && <ListingLayout listing={listing!} />}
{kind === 'post' && Content && <PostLayout post={post!} headings={rendered!.headings}><Content /></PostLayout>}
{kind === 'alias' && <Base title={post!.data.title} description={post!.data.description} canonical={destination} noindex redirect={destination}>
  <script slot="head" is:inline define:vars={{ destination }}>
    // Keep heading links and category navigation when an old slug is used.
    window.location.replace(destination + window.location.search + window.location.hash);
  </script>
  <section class="page-content prose"><h1>글 주소가 변경되었습니다</h1><p><a href={destination}>{post!.data.title} — 현재 글로 이동</a></p></section>
</Base>}
