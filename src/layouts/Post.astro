---
import { displayDate } from '../lib/dates.ts';
import Base from './Base.astro';
import TOC from '../components/TOC.astro';
import { readContent, publicSeries } from '../lib/content.ts';
import { adjacentPosts } from '../lib/listing.ts';
import type { Post } from '../lib/content.ts';
interface Props { post: Post; headings: { depth: number; slug: string; text: string }[] }
const { post, headings } = Astro.props;
const p = post.data;
const content = readContent();
const memberships = publicSeries(content).filter(s => s.posts.some(entry => entry.data.id === p.id));
const all = adjacentPosts(content.posts, p.id);
const category = adjacentPosts(content.posts, p.id, p.category);
const hasTOC = headings.some(h => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
---
<Base title={p.title} description={p.description} type="article" publishedAt={p.publishedAt} updatedAt={p.updatedAt}>
  <div class:list={['post-grid', { 'with-toc': hasTOC }]}>
    <article class="post-content" lang="ko" data-pagefind-body>
      <header class="post-heading">
        <a class="eyebrow" href={`/category/${p.category}/`} data-pagefind-ignore>{content.categories[p.category].name}</a>
        <h1 data-pagefind-meta="title">{p.title}</h1>
        <div class="post-meta" data-pagefind-ignore>게시 <time datetime={p.publishedAt!}>{displayDate(p.publishedAt!)}</time>{p.updatedAt && <span>· 수정 <time datetime={p.updatedAt}>{displayDate(p.updatedAt)}</time></span>}</div>
        <p class="post-description" data-pagefind-meta="description" data-pagefind-ignore>{p.description}</p>
      </header>
      <div class="prose post-body"><slot /></div>
    </article>
    <TOC headings={headings} />
    <div class="post-afterword" data-pagefind-ignore>
      {memberships.map(series => {
        const position = series.posts.findIndex(entry => entry.data.id === p.id);
        const previousInSeries = series.posts[position - 1];
        const nextInSeries = series.posts[position + 1];
        return <section class="series-navigation" aria-label="시리즈 탐색">
        <p class="eyebrow">시리즈 · {position + 1} / {series.posts.length}</p><h2><a href={`/series/${series.id}/`}>{series.name}</a></h2>
        <ol>{series.posts.map(entry => <li><a href={`/writing/${entry.data.slug}/`} aria-current={entry.data.id === p.id ? 'page' : undefined}>{entry.data.title}</a>{entry.data.id === p.id && <span class="current-label">현재 글</span>}</li>)}</ol>
        <nav class="adjacent-links" aria-label="시리즈 이전과 다음">{previousInSeries && <a href={`/writing/${previousInSeries.data.slug}/`}>← 시리즈 이전 글<span>{previousInSeries.data.title}</span></a>}{nextInSeries && <a href={`/writing/${nextInSeries.data.slug}/`}>시리즈 다음 글 →<span>{nextInSeries.data.title}</span></a>}</nav>
      </section>; })}
      <section class="chronological-navigation" data-post-navigation="all">
        <p class="eyebrow">전체 글 · 게시일 기준</p>
        <nav class="adjacent-links" aria-label="전체 글 이전과 다음">{all.previous && <a href={`/writing/${all.previous.data.slug}/`}>← 이전글<span>{all.previous.data.title}</span></a>}{all.next && <a href={`/writing/${all.next.data.slug}/`}>다음글 →<span>{all.next.data.title}</span></a>}</nav>
      </section>
      <section class="chronological-navigation" data-post-navigation="category" data-navigation-category={p.category} hidden>
        <p class="eyebrow">{content.categories[p.category].name} · 게시일 기준</p>
        <nav class="adjacent-links" aria-label="분류 내 이전과 다음">{category.previous && <a href={`/writing/${category.previous.data.slug}/?category=${encodeURIComponent(p.category)}`}>← 이전글<span>{category.previous.data.title}</span></a>}{category.next && <a href={`/writing/${category.next.data.slug}/?category=${encodeURIComponent(p.category)}`}>다음글 →<span>{category.next.data.title}</span></a>}</nav>
        {!category.previous && !category.next && <p class="empty-state">이 분류에 다른 글이 없습니다.</p>}
      </section>
      <!-- Future comments module can use this layout slot; v1 has no comments implementation. -->
      <slot name="after-post" />
    </div>
  </div>
</Base>
<script>
  import '../scripts/post-navigation.ts';
</script>
