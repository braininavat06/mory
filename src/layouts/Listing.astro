---
import Base from './Base.astro';
import Pagination from '../components/Pagination.astro';
import { readContent, orderedCategories } from '../lib/content.ts';
import { renderWritingItems } from '../lib/html.ts';
import { SORTS, SORT_NAMES, listUrl } from '../lib/listing.ts';
import type { Listing } from '../lib/listing.ts';
interface Props { listing: Listing; title?: string; categoryId?: string }
const { listing: l, title = '글', categoryId } = Astro.props;
const content = readContent();
const pageTitle = `${title}${l.sort === 'latest' ? '' : ` · ${SORT_NAMES[l.sort]}`}${l.page > 1 ? ` · ${l.page}페이지` : ''}`;
---
<Base title={pageTitle} description={`${title}의 공개 글 목록. ${SORT_NAMES[l.sort]}, ${l.page}페이지.`}>
  <section class="listing-content">
    <header class="page-heading"><p class="eyebrow">글 아카이브</p><h1>{title}</h1><p>{l.total}편의 글</p></header>
    <nav class="category-nav" aria-label="분류별 글"><a href="/writing/" aria-current={!categoryId ? 'page' : undefined}>전체</a>{orderedCategories(content).map(([id, c]) => <a href={`/category/${id}/`} aria-current={id === categoryId ? 'page' : undefined}>{c.name}</a>)}</nav>
    <nav class="sort-nav" aria-label="글 정렬">{SORTS.map(sort => <a href={listUrl(l.base, sort)} aria-current={l.sort === sort ? 'page' : undefined}>{SORT_NAMES[sort]}</a>)}</nav>
    <Fragment set:html={renderWritingItems(l.posts, content, categoryId)} />
    <Pagination listing={l} />
  </section>
</Base>
